{
  "name": "@block-style-cms/sdk",
  "version": "0.0.1",
  "description": "Node.js SDK for Block Style CMS",
  "authors": [
    {
      "name": "Biscuit Zhou",
      "email": "biscuit_zhou@outlook.com"
    }
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check src test",
    "publish:sample": "npm run build && node test/publish_sample_article.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
