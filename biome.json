{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "files": {
    "include": ["packages/js/**/*.ts", "packages/js/**/*.json"],
    "ignore": ["**/dist/**", "**/node_modules/**", "**/.venv/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 4
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
